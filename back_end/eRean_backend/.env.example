# Copy this file to `.env` (same folder) and fill in real values.
# `.env` holds secrets and must never be committed.

# Django settings
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL).
# A single DATABASE_URL wins over the DB_* settings below when it is set.
# Hosts like Render supply it for you, so leave it empty for local work.
#   postgres://user:password@host:5432/dbname
DATABASE_URL=
# TLS is required whenever DEBUG=False. Set to False if your database is on
# the same private network and does not speak TLS.
# DB_SSL_REQUIRE=True

DB_NAME=eRean_DB
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS — must match the origin the Vite dev server runs on.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only read when DEBUG=False.
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Set automatically by Render. Adds its own hostname to ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS, so you never have to hard-code the deployed URL.
# RENDER_EXTERNAL_HOSTNAME=erean-api.onrender.com
