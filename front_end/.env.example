# Leave EMPTY to use the Vite dev proxy (see vite.config.js). Requests then go
# to the same origin the page was served from and Vite forwards them to Django,
# which is what you want when the browser and the backend aren't on the same
# host — e.g. running in a container.
#
# Set an absolute URL only if you are pointing the app at a backend that the
# browser can reach directly, e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
